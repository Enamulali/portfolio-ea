{
  "name": "portfolio-ea",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node prerender.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "eslint": "^10.12.0",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.2",
    "wrangler": "^4.35.0"
  }
}
